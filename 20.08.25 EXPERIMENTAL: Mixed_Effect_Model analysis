import statsmodels.formula.api as smf

def run_mixed_effect_model(ps1_object, treatment_col, random_effect_col, time_col,
                           analysis_level, top_n_features=20):
    """
    Runs a Negative Binomial GEE and now merges the results with the taxonomy
    table to return a fully annotated DataFrame.
    """
    logger.info(f"Running Negative Binomial GEE at the {analysis_level} level...")
    try:
        asv_table = ps1_object['asv'].astype(int)
        metadata = ps1_object['meta']
        taxa = ps1_object['tax'] # This is our full taxonomy table

        required_cols = [treatment_col, random_effect_col]
        use_time_col = time_col and time_col.strip() and time_col in metadata.columns
        if top_n_features is None or top_n_features <= 0:
            top_n_features = 20
            logger.info(f"Top N features not specified; using default value of {top_n_features}")
        if use_time_col:
            required_cols.append(time_col)
        
        if any(col not in metadata.columns for col in required_cols):
            missing = [col for col in required_cols if col not in metadata.columns]
            logger.error(f"FATAL: Metadata is missing required columns: {missing}")
            return pd.DataFrame()

        model_formula = f"abundance ~ {treatment_col}"
        if use_time_col:
            model_formula += f" * {time_col}"

        if analysis_level == 'ASV':
            feature_table = asv_table.T
        else:
            aggregated_table = asv_table.groupby(by=taxa[analysis_level]).sum()
            feature_table = aggregated_table.T

        if feature_table.empty:
            return pd.DataFrame()

        top_features = feature_table.sum(axis=0).nlargest(top_n_features).index
        
        all_results = []
        for i, feature_id in enumerate(top_features):
            abundance_data = feature_table[feature_id]
            abundance_data.index.name = metadata.index.name
            
            df_long = metadata[required_cols].join(abundance_data.rename('abundance'))
            df_long.dropna(inplace=True)

            if df_long.empty or df_long['abundance'].var() == 0:
                continue

            try:
                gee_model = smf.gee(
                    formula=model_formula, groups=df_long[random_effect_col],
                    data=df_long, cov_struct=sm.cov_struct.Exchangeable(),
                    family=sm.families.NegativeBinomial()
                )
                gee_results = gee_model.fit()
                
                p_values = gee_results.pvalues
                coeffs = gee_results.params
                conf_int = gee_results.conf_int()
                
                for var in p_values.index:
                    if p_values[var] < 0.05:
                        # For the feature_id, we store the actual ASV sequence or Taxon name
                        result = {
                            'Feature_ID': feature_id, # This is our key for merging
                            'Variable': var, 'Coefficient': coeffs[var], 'P-value': p_values[var],
                            'Conf. Int. Lower': conf_int.loc[var, 0], 'Conf. Int. Upper': conf_int.loc[var, 1]
                        }
                        all_results.append(result)
            except Exception as e:
                logger.warning(f"FAILED to fit GEE for {feature_id}. Reason: {e}")
                continue
        
        if not all_results:
            logger.info("Model fitting complete. No statistically significant associations were found.")
            return pd.DataFrame()

        # --- NEW: Post-analysis merging with taxonomy ---
        results_df = pd.DataFrame(all_results)
        
        if analysis_level == 'ASV':
            # The 'Feature_ID' is the ASV sequence, which is the index of the taxa table
            annotated_df = results_df.merge(taxa, left_on='Feature_ID', right_index=True, how='left')
        else:
            # For taxon level, we create a representative taxonomy table to merge with
            # This avoids creating duplicate rows from the main taxa table
            representative_taxa = taxa.groupby(taxa[analysis_level]).first()
            annotated_df = results_df.merge(representative_taxa, left_on='Feature_ID', right_index=True, how='left')

        return annotated_df.sort_values('P-value')

    except Exception as e:
        logger.error(f"CRITICAL ERROR in run_mixed_effect_model function: {e}", exc_info=True)
        return pd.DataFrame()

    
