    )
    return fig


def fill_taxonomy_forward(taxa_df):
    """
    Fills missing taxonomic ranks by using the last known rank as a prefix.
    Example: A missing 'Family' after 'Order_X' becomes 'Order_X_unclassified_family'.
    """
    logger.info("Performing forward-fill on taxonomy table...")
    # Define the ranks in their hierarchical order
    ranks = ['Kingdom', 'Phylum', 'Class', 'Order', 'Family', 'Genus', 'Species']
    filled_taxa = taxa_df.copy()

    # Use a more robust set of markers for unassigned taxa
    missing_markers = {'', None, np.nan, 'unassigned', 'unclassified'}

    for index, row in filled_taxa.iterrows():
        last_known_taxon = None
        last_known_rank_name = None

        for rank in ranks:
            current_taxon = row[rank]
            
            # Check if the current rank is effectively missing
            is_missing = pd.isna(current_taxon) or str(current_taxon).strip().lower() in missing_markers
            
            if is_missing:
                # If there's a known higher rank, create a placeholder
                if last_known_taxon:
                    placeholder = f"{last_known_taxon} (unclassified {rank})"
                    filled_taxa.at[index, rank] = placeholder
            else:
                # If the rank is present, update our 'last known' tracker
                last_known_taxon = current_taxon
                last_known_rank_name = rank
                
    return filled_taxa
