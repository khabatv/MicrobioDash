def _fit_zinb_for_one_feature(feature_id, feature_table, metadata, model_formula, random_effect_col):
    """
    Worker function to fit a PyMC ZINB model for a single taxonomic feature.
    Designed to be called in parallel. It is self-contained.
    """
    try:
        # 1. Prepare the data for this specific feature
        df_long = metadata.join(feature_table[feature_id].rename('abundance')).dropna()

        if df_long.empty or df_long['abundance'].var() == 0:
            return None # Return nothing if data is invalid for this feature

        # 2. Use Patsy to create design matrices
        y_patsy, X_patsy = patsy.dmatrices(model_formula, data=df_long)
        y_values = np.asarray(y_patsy).flatten().astype(int)
        X_matrix = np.asarray(X_patsy)
        predictor_names = X_patsy.design_info.column_names

        # 3. Create indices for the random effect groups
        group_labels = df_long[random_effect_col].astype('category')
        group_idx = group_labels.cat.codes.values
        num_groups = len(group_labels.cat.categories)

        # 4. Define and run the PyMC model
        with pm.Model() as model:
            # Priors for fixed effects (using tighter, more stable priors)
            betas = pm.Normal("betas", mu=0, sigma=5, shape=X_matrix.shape[1])

            # Non-Centered parameterization for the random effect (CRITICAL for stability)
            offset_raw = pm.Normal("offset_raw", mu=0, sigma=1, shape=num_groups)
            sigma_random = pm.HalfNormal("sigma_random", sigma=2)
            offset_random = pm.Deterministic("offset_random", offset_raw * sigma_random)

            # Priors for dispersion and zero-inflation
            alpha = pm.HalfCauchy("alpha", beta=1)
            psi_intercept = pm.Normal("psi_intercept", mu=0, sigma=5)

            # Linear Model
            est = X_matrix @ betas + offset_random[group_idx]
            mu = pt.exp(est)
            psi = pm.math.invlogit(psi_intercept)

            # Likelihood
            y_obs = pm.ZeroInflatedNegativeBinomial("y_obs", psi=psi, alpha=alpha, mu=mu, observed=y_values)

            # Sampling: CRITICAL - each worker uses only ONE core. Joblib manages the rest.
            idata = pm.sample(
                draws=2000, tune=1500, chains=4, 
                target_accept=0.999, 
                cores=1,            # <--- Each worker gets 1 core
                progressbar=False   # <--- Keep this off to prevent console flooding
            )

        # 5. Extract and return significant results
        posterior_betas = idata.posterior["betas"]
        feature_results = []
        for i, var_name in enumerate(predictor_names):
            beta_samples = posterior_betas.sel(betas_dim_0=i).values.flatten()
            mean_coeff = beta_samples.mean()
            hdi_low, hdi_high = az.hdi(beta_samples, hdi_prob=0.94)

            if (hdi_low > 0 and hdi_high > 0) or (hdi_low < 0 and hdi_high < 0):
                feature_results.append({
                    'Feature_ID': feature_id, 'Variable': var_name, 'Coefficient': mean_coeff,
                    'P-value': '< 0.05 (Bayesian)', 'Conf. Int. Lower': hdi_low, 'Conf. Int. Upper': hdi_high
                })
        
        logger.info(f"Successfully completed analysis for feature: {feature_id}")
        return feature_results

    except Exception as e:
        # A robust worker function logs errors but does not crash the whole process
        logger.warning(f"FAILED to fit PyMC ZINB model for '{feature_id}'. Reason: {e}")
        return None # Return nothing on failure



def run_pymc_zinb_mixed_model(ps1_object, treatment_col, random_effect_col, time_col,
                               analysis_level, top_n_features=20):
    """
    Runs a Bayesian ZINB Mixed-Effects model in PARALLEL using joblib.
    This function acts as the orchestrator.
    """
    logger.info(f"Running PARALLEL Bayesian ZINB Model at the {analysis_level} level...")
    if top_n_features is None or top_n_features <= 0:
        top_n_features = 20

    try:
        # --- 1. Initial Data Setup (same as before) ---
        asv_table = ps1_object['asv'].astype(int)
        metadata = ps1_object['meta']
        taxa = ps1_object['tax']

        model_formula = f"abundance ~ {treatment_col}"
        use_time_col = time_col and time_col.strip() and time_col in metadata.columns
        if use_time_col:
            model_formula += f" * {time_col}"

        if analysis_level == 'ASV':
            feature_table = asv_table.T
        else:
            feature_table = asv_table.groupby(by=taxa[analysis_level]).sum().T

        top_features = feature_table.sum(axis=0).nlargest(top_n_features).index

        # --- 2. Run the Worker Function in Parallel ---
        # n_jobs=-1 tells joblib to use all available CPU cores.
        # This is where the parallelization happens!
        logger.info(f"Distributing analysis of {len(top_features)} features across multiple CPU cores...")
        
        all_results_list = Parallel(n_jobs=-1)(
            delayed(_fit_zinb_for_one_feature)(
                feature_id, feature_table, metadata, model_formula, random_effect_col
            ) for feature_id in top_features
        )

        # --- 3. Collect and Process the Results ---
        # The output is a list of lists (and Nones for failed models).
        # We flatten it into a single clean list of result dictionaries.
        all_results = [item for sublist in all_results_list if sublist for item in sublist]

        if not all_results:
            logger.info("Parallel model fitting complete. No statistically significant associations found.")
            return pd.DataFrame()

        results_df = pd.DataFrame(all_results)

        # Annotate with taxonomy (same as before)
        if analysis_level == 'ASV':
            annotated_df = results_df.merge(taxa, left_on='Feature_ID', right_index=True, how='left')
        else:
            representative_taxa = taxa.groupby(taxa[analysis_level]).first()
            annotated_df = results_df.merge(representative_taxa, left_on='Feature_ID', right_index=True, how='left')

        logger.info("Successfully completed parallel ZINB analysis.")
        return annotated_df.sort_values('Coefficient', key=abs, ascending=False)

    except Exception as e:
        logger.error(f"CRITICAL ERROR in parallel PyMC model orchestrator: {e}", exc_info=True)
        return pd.DataFrame()


def format_lme_results_for_display(results_df, ps1_object, treatment_col, time_col):
    """
    Presents the fully annotated model output in a rich HTML table.
    This version correctly handles both numeric and string-based p-values.
    """
    if results_df is None or results_df.empty:
        return html.Div([
            html.H4("Mixed-Effect Model Results"),
            html.P("No significant associations were found.")
        ])

    baseline = sorted(ps1_object['meta'][treatment_col].unique())[0]
    display_cols = ['Feature_ID', 'Interpretation', 'Fold Change', 'P-value', 'Phylum', 'Order', 'Family', 'Genus', 'Species']
    df = results_df.copy()

    df['Fold Change'] = np.exp(df['Coefficient'])

    def get_interpretation(row):
        var = row['Variable']
        if var == 'Intercept': return "Baseline abundance"
        if f"T.{treatment_col}" in var or treatment_col in var:
            category = var.replace(f"{treatment_col}[T.", "").replace("]", "")
            return f"Effect of {category} (vs. {baseline})"
        if time_col and time_col in var and ":" not in var:
            return f"Effect of one-unit increase in {time_col}"
        if time_col and ":" in var:
            return "Interaction Effect"
        return var

    df['Interpretation'] = df.apply(get_interpretation, axis=1)

    # --- THIS IS THE CRITICAL FIX ---
    # Check if the 'P-value' column contains numbers before trying to format them.
    if pd.api.types.is_numeric_dtype(df['P-value']):
        # This will only run for the GEE model's output
        df['P-value'] = df['P-value'].map('{:.2e}'.format)
    # If the p-values are strings (from the Bayesian model), this block is skipped.

    df['Fold Change'] = df['Fold Change'].map('{:.2f}x'.format)
    df.rename(columns={'Feature_ID': 'Feature'}, inplace=True)

    final_df = df[[col for col in display_cols if col in df.columns]]
    final_df.fillna('-', inplace=True)

    table_header = [html.Thead(html.Tr([html.Th(col) for col in final_df.columns]))]
    table_body = [html.Tbody([html.Tr([html.Td(final_df.iloc[i][col]) for col in final_df.columns]) for i in range(len(final_df))])]

    return html.Div([
        html.H4("Significant Associations from Mixed-Effect Model"),
        html.P(f"Shows variables significantly associated with feature abundance. The baseline for comparison is '{baseline}'."),
        html.Table(table_header + table_body, style={'marginLeft': 'auto', 'marginRight': 'auto', 'marginTop': '20px', 'textAlign': 'left'})
    ])

def plot_lme_results(results_df):
    """
    Creates a forest plot, now using the full Feature_ID for more descriptive labels.
    """
    if results_df is None or results_df.empty or 'Conf. Int. Lower' not in results_df.columns:
