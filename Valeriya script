def ai_analyze_quality_profiles(fnFs, fnRs, sample_limit=2, records_limit=10000):
    if not ai_available or not fnFs:
        return None
    
    logger.info(f"Analyzing quality profiles from the first {records_limit} records of {min(sample_limit, len(fnFs))} file(s).")
    quality_summary = []
    for fnF, fnR in zip(fnFs[:sample_limit], fnRs[:sample_limit]):
        try:
            # Use islice to avoid reading the whole file into memory
            with gzip.open(fnF, 'rt') as f_handle:
                records_f = list(islice(SeqIO.parse(f_handle, 'fastq'), records_limit))
            with gzip.open(fnR, 'rt') as r_handle:
                records_r = list(islice(SeqIO.parse(r_handle, 'fastq'), records_limit))

            if not records_f or not records_r:
                logger.warning(f"No records found in sample for {fnF} or {fnR}")
                continue

            qual_f = [np.mean(r.letter_annotations['phred_quality']) for r in records_f]
            qual_r = [np.mean(r.letter_annotations['phred_quality']) for r in records_r]
            
            quality_summary.append({
                'forward_mean_qual': np.mean(qual_f),
                'reverse_mean_qual': np.mean(qual_r),
                'forward_length': np.mean([len(r) for r in records_f]),
                'reverse_length': np.mean([len(r) for r in records_r])
            })
        except Exception as e:
            logger.error(f"Error processing quality for {fnF}: {e}")
            continue

    if not quality_summary:
        logger.error("Could not generate any quality summaries from the provided files.")
        return None

    prompt = f"""
    Given the quality profile summary from the first {records_limit} reads of {len(quality_summary)} sample(s):
    {quality_summary}
    Suggest optimal truncation lengths and max expected errors.
    Aim for average quality scores >30 and try to retain at least 70% of the read length.
    Return a JSON object: {{'trunc_len_f': integer, 'trunc_len_r': integer, 'max_ee': [float, float]}}
    """
    try:
        response = model.generate_content(prompt)
        if response and hasattr(response, 'text'):
            import json
            # Clean up potential markdown formatting from the AI response
            clean_response = response.text.strip().replace('```json', '').replace('```', '')
            return json.loads(clean_response)
    except Exception as e:
        logger.error(f"AI quality profile analysis failed: {e}")
        return None
    return None



